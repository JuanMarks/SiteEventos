# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA deve ser versionado (está no .gitignore).

# Django
SECRET_KEY=troque-por-uma-chave-secreta-forte
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://localhost:8000

# Banco de dados (PostgreSQL)
DB_NAME=site_eventos
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres
DB_HOST=localhost
DB_PORT=5432

# E-mail (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@exemplo.com
EMAIL_HOST_PASSWORD=sua-app-password
DEFAULT_FROM_EMAIL=seu-email@exemplo.com

# Código exigido para se cadastrar como ADM (deixe vazio para bloquear auto-cadastro de ADM)
ADMIN_REGISTRATION_CODE=
